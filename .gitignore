# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# processed product images
/public/products/*.webp

# large data files
/data/

# database backups
backups/
*.sql

# local environment
.env.local

# log files
*.log
.env*.local

# build cache (pre-exported product data)
.cache/

# script output/reports
scripts/output/
playwright-report/
test-results/

# local notes/artifacts
gpt-enrich-products-script.rtf
product-enrichment-reguirments-prompt.rtf
package-lock.json

# News-agent local state (reject memory) — disposable, per-machine
scripts/news-agent/.state/
