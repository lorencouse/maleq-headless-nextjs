# ── News Agent · social credentials ───────────────────────────────────────
# Copy the values you collect into your REAL .env.local (Bun auto-loads it).
# NEVER commit real tokens. This .example file is safe to commit.

# ── Bluesky ── (Settings → Privacy & Security → App Passwords)
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Mastodon ── (Preferences → Development → New application, scope: write:statuses)
# The adapter accepts MASTODON_ACCESS_TOKEN or MASTODON_CLIENT_ACCESS_TOKEN.
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_CLIENT_ACCESS_TOKEN=

# ── Reddit ── ("script" app at https://www.reddit.com/prefs/apps → create app → script)
# Posts a LINK submission to REDDIT_SUBREDDIT (a sub you control, e.g. mqnews — no "r/").
# client id = the string under the app name; secret = the "secret" field.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=mqnews
# Optional: mark submissions NSFW (1), or pin a post flair by id.
REDDIT_NSFW=
REDDIT_FLAIR_ID=

# ── Pexels (cover images) ── (free key at https://www.pexels.com/api/)
# Thematic stock fallback when a story isn't about one named person.
PEXELS_API_KEY=

# ── Pinterest ── (developers.pinterest.com → app)
# Authorize with scopes: user_accounts:read,boards:read,boards:write,pins:read,pins:write
# (creating a pin needs boards:write + pins:read too, not just pins:write).
# CLAIM maleq.com in Pinterest settings first. Pins link only to clean /guides/ news —
# never adult product content — to stay within Pinterest's policy. Leave blank = off.
# PREFERRED (set-and-forget): refresh-token mode — refresh tokens last ~1 year, don't rotate.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=
# FALLBACK only (expires in weeks): a static access token. Refresh mode wins if both set.
PINTEREST_ACCESS_TOKEN=

# ── Tumblr ── (register an app at https://www.tumblr.com/oauth/apps → OAuth1.0a creds)
# OAuth 1.0a (tokens don't expire). BLOG_IDENTIFIER is your blog host, e.g. maleq.tumblr.com.
# Clean editorial news only (mature ok, explicit imagery banned). Leave blank = off.
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_TOKEN=
TUMBLR_TOKEN_SECRET=
TUMBLR_BLOG_IDENTIFIER=

# ── Telegram ── (broadcast channel via the Bot API — no link suppression, full reach)
# 1) @BotFather → /newbot → copy the token. 2) Make a public channel (t.me/maleqnews),
# add the bot as an admin with "Post messages". 3) CHANNEL = the @username (public) or
# the numeric -100… chat id. Set-and-forget (token never expires). Leave blank = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@maleqnews

# ── Nostr ── (decentralized, censorship-resistant; same fediverse bet as Bluesky)
# NOSTR_NSEC = the channel keypair's SECRET key (nsec1… or 64-char hex). Generate one in
# any Nostr client, or:
#   bun -e "import('nostr-tools').then(t=>{const sk=t.generateSecretKey();console.log('nsec',t.nip19.nsecEncode(sk));console.log('npub',t.nip19.npubEncode(t.getPublicKey(sk)))})"
# NOSTR_RELAYS is optional (sensible defaults baked in). Leave NSEC blank = off.
NOSTR_NSEC=
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band,wss://relay.primal.net

# ── Web Push (our own PWA subscribers) ── (highest-reliability channel; no platform risk)
# Broadcasts each news post to subscribers who opted into "LGBTQ News" (pref_news = 1).
# Run `bun run scripts/migrate-add-pref-news.ts [--local]` once (local + prod) first.
# These VAPID keys are the SAME ones the Next.js app already uses for push — reuse them;
# do NOT generate a new pair (subscribers are bound to the existing public key).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@maleq.com

# ── Openverse (celebrity portraits, secondary) ──
# CC/PD image search (indexes Flickr, Wikimedia, museums…). Works ANONYMOUSLY with
# no key. These optional creds (free, instant, no Flickr-Pro needed) just raise the
# rate limit: register at https://api.openverse.org/v1/auth_tokens/register/
# Wikimedia Commons (no key) is tried first; Openverse is the secondary source.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# ── TMDB (movie / TV posters, editorial fair use) ──
# Official posters for posts ABOUT a film or series. Posters are studio copyright
# (NOT freely licensed) — used at modest size, credited, under editorial fair use.
# OFF by default: set BOTH the key (free: themoviedb.org → Settings → API → v3 key)
# AND the opt-in flag below. Leave the flag unset/0 to keep posters disabled.
TMDB_API_KEY=
NEWS_AGENT_TMDB_POSTERS=

# ── Meta (Facebook Page + Instagram) ──
# From developers.facebook.com → your App → Settings
META_APP_ID=
META_APP_SECRET=
# Long-lived Page access token (we'll generate this together)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram Business account ID linked to the Page (only if posting to IG)
META_IG_USER_ID=
